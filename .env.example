# 复制一份改名为 .env，再把下面的值换成自己的。.env 不要提交到 git。

# 数据库连接：postgresql+psycopg_async://用户名:密码@主机:端口/数据库名
DB_URI=postgresql+psycopg_async://postgres:your_password@127.0.0.1:5432/db_py

# JWT 签名密钥，必须是长随机字符串，用下面的命令生成：
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me

# Redis 地址，不写默认 redis://127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# 通义千问 API Key，在阿里云百炼控制台的 API-KEY 页面获取
DASHSCOPE_API_KEY=sk-your_key
