# 复制成 .env.production 后按实际环境修改，.env.production 不提交到 git、不打进镜像
# 线上全部填阿里云服务的 VPC 内网地址；密码里有 @ : / # 等特殊字符要做 URL 编码

# RDS PostgreSQL 的内网地址
DB_URI=postgresql+psycopg_async://用户名:密码@pgm-xxxx.pg.rds.aliyuncs.com:5432/db_py

JWT_SECRET_KEY=change_me
DASHSCOPE_API_KEY=sk-your_key

# 云 Redis 的内网地址
REDIS_URL=redis://:密码@r-xxxx.redis.rds.aliyuncs.com:6379/0

# 云 RabbitMQ 的 VPC 接入点。用户名密码是控制台生成的静态账号，最后一段是 Vhost
RABBITMQ_URL=amqp://静态用户名:静态密码@rabbitmq-cn-xxxx.cn-hangzhou.amqp-xx.net.mq.amqp.aliyuncs.com:5672/pyfast

# OSS：ECS 和 bucket 都在杭州，上传走内网。线上更推荐给 ECS 绑 RAM 角色，服务器上不放 AccessKey
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_INTERNAL=true
